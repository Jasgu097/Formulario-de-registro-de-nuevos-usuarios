# Puerto del servidor
PORT=3000

# URL base publica de la app (se usa para armar el enlace de verificacion)
BASE_URL=http://localhost:3000

# Configuracion SMTP para enviar el correo de validacion
# Ejemplo con Gmail: host smtp.gmail.com, puerto 465 (SSL) o 587 (TLS)
# Si usas Gmail, debes crear una "contrasena de aplicacion", no la contrasena normal
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=tu_contrasena_o_app_password
SMTP_FROM="Mi App" <no-reply@example.com>

# Secreto usado internamente (no es estrictamente necesario, pero se deja por si se agrega JWT en el futuro)
APP_SECRET=cambia_esto_por_un_valor_aleatorio
